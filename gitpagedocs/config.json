{
  "site": {
    "name": "CineSwipe",
    "defaultLanguage": "pt",
    "languages": {
      "en": true,
      "pt": true,
      "es": true
    },
    "HideThemeSelector": true,
    "ThemeDefault": "duet-dark",
    "ThemeModeDefault": "dark",
    "backToTop": {
      "enabled": true,
      "minPageHeightViewports": 3
    },
    "documentNavigation": {
      "position": "center"
    },
    "containerPagination": {
      "enabled": true,
      "alignment": "right",
      "placement": "bottom",
      "display": "icon",
      "showCount": true,
      "controls": {
        "first": true,
        "previous": true,
        "next": true,
        "last": true
      },
      "icons": {
        "first": "FiSkipBack",
        "previous": "FiChevronLeft",
        "next": "FiChevronRight",
        "last": "FiSkipForward"
      },
      "iconSize": "20px",
      "labels": {
        "pages": {
          "en": "Pages",
          "pt": "Páginas",
          "es": "Páginas"
        },
        "first": {
          "en": "First page",
          "pt": "Primeira página",
          "es": "Primera página"
        },
        "previous": {
          "en": "Previous page",
          "pt": "Página anterior",
          "es": "Página anterior"
        },
        "next": {
          "en": "Next page",
          "pt": "Próxima página",
          "es": "Página siguiente"
        },
        "last": {
          "en": "Last page",
          "pt": "Última página",
          "es": "Última página"
        }
      }
    },
